# Lab defaults for VisionTestAI MVP (private Coder VPS + Jetson clinic)
# Copy to lab.env and adjust if needed.

# Private VPS is NOT reachable on the public IP from clinic LAN.
# Run on Mac:  deploy/vps/mac_lan_bridge.sh
# Then Jetson uses the Mac LAN IP as VPS_HOST:
VPS_HOST=192.168.1.78
VPS_SSH=main.aquamarine-leopon-37.vupham.coder
CODER_WORKSPACE=vupham/aquamarine-leopon-37

MQTT_USERNAME=vision
MQTT_PASSWORD=mqtt-dev-pass

MEDIA_TOKEN=dev-media-token
# URLs returned in media grants must be reachable from Jetson → Mac bridge IP
MEDIA_PUBLIC_BASE=http://192.168.1.78:9010
MEDIA_STATIONS=station-01

FACE_VDB_API_KEY=dev-face-vdb-key
# Do not seed 1x1 placeholder JPEGs — AiFace will not build Face templates from them.
FACE_VDB_SEED_DEMO=0

# Frappe site (Docker on VPS). Admin password for create-site.
FRAPPE_ADMIN_PASSWORD=admin
FRAPPE_DB_ROOT_PASSWORD=admin
TRUNG_VUONG_SITE_HOST=trungvuong.vision.primetek.ai
QUAN_Y_SITE_HOST=qdymd.vision.primetek.ai
HOSPITAL_BASE_URL=https://trungvuong.vision.primetek.ai

# Jetson clinic (local)
JETSON_LAN_IP=192.168.1.125
AIFACE_STATION_URL=https://ubuntu.tailf560d4.ts.net
AIFACE_PANEL_IP=192.168.1.18
AIFACE_PANEL_PORT=80
AIFACE_CALLBACK_PORT=7788
STATION_ID=station-01
MAC_LAN_IP=192.168.1.78
