# Bộ v16 đã kiểm tra dependency; có thể override bằng env trước khi build.
: "${FRAPPE_REF:=v16.56.0}"
: "${ERPNEXT_REF:=v16.55.0}"
: "${HEALTHCARE_REF:=v16.8.0}"
: "${DESK_REF:=v3.0.1}"
: "${FRAPPE_DOCKER_COMMIT:=0ad1a1152f93b1285104bcd0a8059e036dc5bd3d}"
export FRAPPE_REF ERPNEXT_REF HEALTHCARE_REF DESK_REF FRAPPE_DOCKER_COMMIT
