<Window x:Class="VisionAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision Agent" Height="720" Width="880"
        MinHeight="700" MinWidth="820" WindowStartupLocation="CenterScreen"
        Background="#FFF1F2F2" FontFamily="Segoe UI" FontSize="13"
        Icon="Assets/vision-agent.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="112" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="HeaderPanel" Grid.Row="0" Grid.ColumnSpan="2" Margin="2,0,2,12">
            <Image Width="34" Height="34" Source="Assets/vision-agent.png" Stretch="Uniform" Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Vision Agent" FontSize="18" FontWeight="SemiBold" Foreground="#24424B" />
                <TextBlock Text="Kết nối thư mục HIS với backend QY" FontSize="12" Foreground="#66777E" />
            </StackPanel>
        </DockPanel>

        <GroupBox x:Name="BackendGroup" Grid.Row="1" Grid.Column="0" Header="Kết nối backend" Margin="2,0,8,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="106" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Backend URL:" />
                <TextBox x:Name="BackendUrlBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" />
                <Label Grid.Row="1" Grid.Column="0" Content="API token:"
                       ToolTip="Token Frappe gồm API Key và API Secret." />
                <PasswordBox x:Name="AuthorizationBox" Grid.Row="1" Grid.Column="1"
                             ToolTip="Dán theo dạng: token API_KEY:API_SECRET" />
                <Button Grid.Row="1" Grid.Column="2" Content="Kiểm tra" Click="TestConnection_Click" />
                <TextBlock x:Name="BackendFeedbackText" Grid.Row="2" Grid.Column="1"
                           Margin="4,3,2,0" Visibility="Collapsed" TextWrapping="Wrap" />
                <Button x:Name="ExpandCompactButton" Grid.Row="2" Grid.Column="2" Content="Mở rộng"
                        Visibility="Collapsed" Click="Expand_Click" />
            </Grid>
        </GroupBox>

        <StackPanel x:Name="ActionButtons" Grid.Row="1" Grid.Column="1" Margin="0,12,2,8">
            <Button Content="Ẩn vào khay" Click="HideToTray_Click" />
            <Button x:Name="PauseButton" Content="Tạm dừng" Click="Pause_Click" />
            <Button Content="Thu nhỏ" Click="Compact_Click" />
        </StackPanel>

        <GroupBox x:Name="FolderGroup" Grid.Row="2" Grid.Column="0" Header="Nguồn XML" Margin="2,0,8,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="145" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Thư mục XML:" />
                <TextBox x:Name="InboxBox" Grid.Row="0" Grid.Column="1" />
                <Button Grid.Row="0" Grid.Column="2" Content="Chọn…" Click="Browse_Click" />
                <Button Grid.Row="0" Grid.Column="3" Content="Kiểm tra quyền đọc" Click="CheckFolder_Click" />

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="2,6,2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Quét thư mục mỗi:" Width="128" VerticalAlignment="Center" />
                        <TextBox x:Name="PollSecondsBox" Width="62" />
                        <TextBlock Text="giây" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Chờ file ổn định:" Width="128" VerticalAlignment="Center" />
                        <TextBox x:Name="StableSecondsBox" Width="62" />
                        <TextBlock Text="giây" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="FolderFeedbackText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                           Margin="4,3,2,0" Visibility="Collapsed" TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <GroupBox x:Name="StatusGroup" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                  Header="Trạng thái" Margin="2,0,2,10" Padding="10">
            <StackPanel>
                <TextBlock x:Name="WindowsAccountText" Margin="2,0,2,5" />
                <DockPanel>
                    <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="12" Height="12"
                             Fill="Gray" Margin="3,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Chưa cấu hình" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="OptionsGroup" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                  Header="Tùy chọn" Margin="2,0,2,10" Padding="8">
            <StackPanel>
                <WrapPanel>
                    <CheckBox x:Name="AutostartCheck" Content="Chạy cùng Windows" Margin="4,3,20,3" />
                    <CheckBox x:Name="MinimizeToTrayCheck" Content="Ẩn xuống khay khi đóng cửa sổ"
                              Margin="4,3" IsChecked="True" />
                </WrapPanel>
                <DockPanel Margin="2,6,2,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Chọn…" Width="112" Click="BrowseReport_Click" />
                    <TextBlock Text="Folder báo cáo:" Width="112" VerticalAlignment="Center" Margin="2,0,8,0" />
                    <TextBox x:Name="ReportPathBox" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="2,6,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Giờ chốt báo cáo:" Width="138" VerticalAlignment="Center" />
                    <TextBox x:Name="ReportHourBox" Width="52" HorizontalContentAlignment="Center" Text="17" />
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,2,0" />
                    <TextBox x:Name="ReportMinuteBox" Width="52" HorizontalContentAlignment="Center" Text="00" />
                    <TextBlock Text="(định dạng 24 giờ)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#66777E" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tạo lại báo cáo ngày:" Width="138" VerticalAlignment="Center" />
                    <DatePicker x:Name="ReportDatePicker" Width="150" SelectedDateFormat="Short"
                                ToolTip="Chọn ngày muốn tạo lại báo cáo HTML." />
                    <Button x:Name="CreateReportButton" Content="Tạo lại báo cáo" Margin="8,2,2,2"
                            Padding="14,4" Click="CreateReport_Click"
                            ToolTip="Tạo lại báo cáo HTML tổng hợp và chi tiết cho ngày đã chọn; file cũ sẽ được ghi đè." />
                    <TextBlock Text="Ghi đè HTML cũ nếu có" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="#66777E" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <DockPanel x:Name="FooterPanel" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,0,2,0">
            <Button DockPanel.Dock="Left" Content="Nhật ký…" Click="OpenLog_Click" />
            <Button DockPanel.Dock="Left" Content="Mặc định" Click="Defaults_Click" />
            <Button DockPanel.Dock="Right" Content="Lưu cấu hình" Click="Save_Click" MinWidth="118" />
        </DockPanel>
    </Grid>
</Window>
