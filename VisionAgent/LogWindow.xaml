<Window x:Class="VisionAgent.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision Agent - Nhật ký" Height="430" Width="700"
        WindowStartupLocation="CenterOwner" Background="#FFF0F0F0" FontFamily="Segoe UI">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Đóng" MinWidth="80" Margin="4" IsDefault="True" Click="Close_Click" />
        </StackPanel>
        <GroupBox Header="Nhật ký gần đây" Padding="6">
            <ListBox x:Name="LogList" FontFamily="Consolas" />
        </GroupBox>
    </DockPanel>
</Window>
